{% from "govuk/components/button/macro.njk" import govukButton %}

{#
  saveActions — the Save and continue controls of a journey page.

  Params:
    hubHref                (string)  where Cancel and return to overview goes
    copy                   (object)  the shared save-actions copy
    primary                (object)  optional govukButton params for the primary button
    showReturnControls     (boolean) offer the return controls; default true
#}
{% macro saveActions(params) %}
  {% set copy = params.copy %}
  {% set primary = params.primary %}
  {% set showReturnControls = params.showReturnControls if params.showReturnControls is defined else true %}
  <div class="govuk-button-group">
    {{ govukButton(primary or { text: copy.saveAndContinue }) }}
    {% if showReturnControls %}
      {{ govukButton({
        text: copy.saveAndReturnToHub,
        classes: "govuk-button--secondary",
        name: "exit",
        value: "hub"
      }) }}
    {% endif %}
  </div>
  {% if showReturnControls %}
    <p class="govuk-body">
      <a class="govuk-link" href="{{ params.hubHref }}">{{ copy.cancelAndReturnToHub }}</a>
    </p>
  {% endif %}
{% endmacro %}
