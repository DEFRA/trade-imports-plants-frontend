{% extends "shared/layout.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "shared/section-caption.njk" import sectionCaption %}

{% block journeyContent %}
  {% set referenceHtml %}{{ copy.reference }}<br><strong>{{ reference }}</strong>{% endset %}
  {{ sectionCaption(caption) }}
  {{ govukPanel({ titleText: copy.title, html: referenceHtml }) }}
  <p class="govuk-body">{{ copy.body }}</p>
  <p class="govuk-body"><a class="govuk-link" href="{{ notificationHref }}">{{ copy.viewNotification }}</a></p>
  <p class="govuk-body"><a class="govuk-link" href="{{ dashboardHref }}">{{ copy.returnToDashboard }}</a></p>
{% endblock %}
